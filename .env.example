# Copier ce fichier en .env puis renseigner les valeurs réelles.
# .env n'est jamais commité (voir .gitignore).

# --- PostgreSQL (base "assuml_db") ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=assuml_db
DB_USER=assuml_user
DB_PASS=change_me

# --- FastAPI ---
# Clé partagée entre Django/Streamlit et l'API (header X-API-Key)
API_KEY=change_me

# --- ETL météo (OpenWeatherMap, source api_extractor) ---
OPENWEATHER_API_KEY=change_me

# --- Django ---
DJANGO_SECRET_KEY=change_me
API_BASE_URL=http://localhost:8000

# --- MLflow (tracking local, aucun serveur externe requis) ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Promotion au Model Registry MLflow. Laisser à true en local : chaque
# entraînement retenu y reçoit un nouveau numéro de version, reporté dans
# metadata.json (committé, source de vérité lue par /health).
# Poser false sur un environnement reconstruit à chaque déploiement, où
# mlflow.db repart vide : la promotion est alors neutralisée et le numéro
# déjà inscrit dans metadata.json est conservé, au lieu d'être écrasé par
# le "1" qu'un registre vierge attribuerait.
MLFLOW_ENABLED=true

# --- Métriques d'infrastructure Railway (panneau Monitoring) ---
# Jeton de PROJET (pas de compte) : un jeton de compte donne accès en lecture
# et en écriture à l'ensemble de l'espace Railway, un jeton de projet reste
# cantonné à AssuML. À créer depuis les réglages du projet sur railway.com.
RAILWAY_API_TOKEN=change_me
# Service et environnement à observer — ici le service API.
# Le préfixe MONITORED_ est délibéré : Railway injecte automatiquement
# RAILWAY_SERVICE_ID et RAILWAY_ENVIRONMENT_ID dans chaque conteneur. Réutiliser
# ces noms ferait lire à Django ses propres identifiants au lieu de ceux de
# l'API, et le panneau afficherait silencieusement le mauvais service.
RAILWAY_MONITORED_SERVICE_ID=change_me
RAILWAY_MONITORED_ENVIRONMENT_ID=change_me
# Service recevant le trafic public, ici django. Railway ne comptabilise les
# requêtes HTTP qu'au passage de son proxy public : les appels de Django vers
# l'API empruntent le réseau privé et n'y figurent jamais. Latence, trafic et
# codes de statut portent donc sur ce service, la mémoire restant celle du
# conteneur déclaré ci-dessus. Laisser vide pour observer un seul service.
RAILWAY_MONITORED_WEB_SERVICE_ID=change_me
